# ==============================================================================
# MediConnect Environment Configuration
# Copy this file to .env and adjust values for your local or production environment
# ==============================================================================

# --- Django Security ---
SECRET_KEY=django-insecure-mediconnect-super-secure-production-ready-key-change-in-prod-2026!#
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# --- Database Selection ---
# Set USE_SQLITE=True for instant zero-config local development without PostgreSQL
# Set USE_SQLITE=False to connect to PostgreSQL (locally or in Docker)
USE_SQLITE=True

# --- PostgreSQL Configuration (used when USE_SQLITE=False) ---
DB_NAME=mediconnect_db
DB_USER=mediconnect_user
DB_PASSWORD=mediconnect_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis & Celery Background Tasks ---
# In Docker, host is 'redis'. In local standalone development, host is 'localhost'
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Generative AI Configuration ---
# Store your Google Gemini API Key here (Never commit your real key to GitHub)
GEMINI_API_KEY=your_gemini_api_key_here
